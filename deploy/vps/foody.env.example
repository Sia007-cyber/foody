# Install the real file as /etc/foody/foody.env with mode 0600.
# Values below are placeholders; this file must not be used unchanged.
SPRING_PROFILES_ACTIVE=vps
FOODY_DB_URL=jdbc:mysql://127.0.0.1:3306/foody?serverTimezone=UTC&useUnicode=true&characterEncoding=utf8
FOODY_DB_USERNAME=foody_app
FOODY_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
FOODY_JWT_SECRET=REPLACE_WITH_BASE64_OF_AT_LEAST_32_RANDOM_BYTES
FOODY_CORS_ALLOWED_ORIGINS=https://example.com
FOODY_STORAGE_LOCAL_PATH=/var/lib/foody/uploads
FOODY_BUSINESS_TIME_ZONE=Asia/Tehran
FOODY_DEMO_ACCOUNTS_ENABLED=false
